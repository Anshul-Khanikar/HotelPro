PORT=5000
MONGODB_URI=mongodb://localhost:27017/hotelpro
# Required: provide a long random secret in your local .env; never use this placeholder.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
NODE_ENV=development
# Payment provider is not configured. Booking creation must not be treated as real payment capture.
PAYMENT_MODE=unconfigured